[Unit]
Description=LMU Pitwall relay server
After=network-online.target
Wants=network-online.target
# Behind Traefik in Docker, the relay binds the docker0 address, which exists
# only once Docker is up. Uncomment then, and see README.md, "Traefik".
#After=docker.service
#Requires=docker.service

[Service]
# PITWALL_AGENT_KEY=<at least 32 characters>. A root-only file rather than
# Environment= here: unit files and `systemctl edit` overrides are
# world-readable, and `systemctl show` prints Environment= to any user. Flags
# are no better — they are visible in `ps`. The server refuses to start with a
# short key.
EnvironmentFile=/etc/lmu-pitwall/agent.env

# main.rs picks the log directory from $APPDATA and otherwise falls back to the
# directory holding the executable — which ProtectSystem=strict makes
# read-only. Point it at the state directory instead. Console output still goes
# to the journal either way.
Environment=APPDATA=/var/lib/lmu-pitwall

# Loopback: only a reverse proxy on this host can reach it, so port 9000 is
# never public even if the firewall is misconfigured. For Traefik in Docker use
# the docker0 address instead (README.md, "Traefik").
ExecStart=/opt/lmu-pitwall/lmu-pitwall-server --server --bind 127.0.0.1
Restart=always
RestartSec=5

DynamicUser=yes
StateDirectory=lmu-pitwall
WorkingDirectory=/var/lib/lmu-pitwall
UMask=0077

# ProtectSystem=strict leaves /opt read-only, which is deliberate. The results
# database is opened lazily and its path is *executable*-relative, but in
# --server mode nothing reaches it: the polling loop does not run and the relay
# refuses every viewer command instead of running it. If that ever changes,
# this will surface as an open error rather than a file in /opt.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

# Unprivileged port, no capabilities needed.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

# Outbound HTTPS is still needed: the relay runs its own update check.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

# One room, at most 20 viewers. Generous ceilings that still stop a runaway
# process from taking the VPS with it.
MemoryMax=256M
TasksMax=256
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
